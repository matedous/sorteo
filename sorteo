<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sorteo del Clan</title>
    <!-- Usamos una fuente moderna y profesional de Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,700;0,900&display=swap" rel="stylesheet">
    <style>
        /* Reseteo básico */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f4f6f9;
            color: #2c3e50;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 3rem 1rem;
        }

        /* Contenedor principal estilo tarjeta */
        .card-container {
            background-color: #ffffff;
            max-width: 800px;
            width: 100%;
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            text-align: center;
            margin-bottom: 2rem;
        }

        /* Textos de bienvenida */
        .welcome-title {
            font-size: 2rem;
            font-weight: 900;
            color: #1a252f;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .welcome-message {
            font-size: 1.15rem;
            line-height: 1.6;
            color: #4a5568;
            margin-bottom: 1.5rem;
            font-style: italic;
        }

        /* Aviso legal / Disclaimer */
        .disclaimer {
            background-color: #fff5f5;
            color: #e53e3e;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            border-left: 6px solid #e53e3e;
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Formulario de registro */
        .form-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 1rem;
        }

        .name-input {
            width: 60%;
            max-width: 350px;
            padding: 1rem 1.5rem;
            font-size: 1rem;
            font-family: 'Montserrat', sans-serif;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            outline: none;
            transition: all 0.3s ease;
        }

        .name-input:focus {
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.2);
        }

        .submit-btn {
            padding: 1rem 2rem;
            font-size: 1rem;
            font-weight: 700;
            font-family: 'Montserrat', sans-serif;
            background-color: #2b6cb0;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.1s ease;
        }

        .submit-btn:hover {
            background-color: #2c5282;
        }

        .submit-btn:active {
            transform: scale(0.97);
        }

        /* Sección de Participantes */
        .participants-section {
            max-width: 900px;
            width: 100%;
            text-align: center;
        }

        .participants-title {
            font-size: 1.8rem;
            font-weight: 900;
            color: #1a252f;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Grilla de etiquetas de nombres */
        .participants-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            padding: 1rem;
        }

        .name-badge {
            padding: 0.7rem 1.5rem;
            border-radius: 50px;
            color: white;
            font-weight: 900;
            font-size: 1.1rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            opacity: 0;
            transform: scale(0.8);
        }

        /* Animación para cuando se añade un nombre */
        @keyframes popIn {
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
    </style>
</head>
<body>

    <div class="card-container">
        <h1 class="welcome-title">¡Gran Sorteo!</h1>
        <p class="welcome-message">
            Gracias por participar en el sorteo del clan, algo único que no se ve en otros lados. 
            Te deseo toda la suerte y recuerda, cuanto más veces compres, más posibilidades tienes de ganar 😉.
        </p>

        <div class="disclaimer">
            ⚠️ Atención: Si inscribes tu apodo más veces de las veces que compraste, serás automáticamente eliminado.
        </div>

        <form id="sorteoForm" class="form-group">
            <input type="text" id="apodoInput" class="name-input" placeholder="Ingresa tu apodo..." autocomplete="off" required>
            <button type="submit" class="submit-btn">Inscribirme</button>
        </form>
    </div>

    <div class="participants-section">
        <h2 class="participants-title">Participantes</h2>
        <div id="participantsGrid" class="participants-grid">
            <!-- Los nombres se insertarán aquí dinámicamente -->
        </div>
    </div>

    <script>
        // Paleta de colores profesionales pero llamativos (Flat UI Colors)
        const colores = [
            '#e53e3e', // Rojo
            '#3182ce', // Azul
            '#38a169', // Verde
            '#d69e2e', // Amarillo/Dorado
            '#805ad5', // Morado
            '#dd6b20', // Naranja
            '#319795', // Cerceta
            '#e53e3e'  // Rosa fuerte
        ];

        document.getElementById('sorteoForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Evita que la página se recargue

            const input = document.getElementById('apodoInput');
            const apodo = input.value.trim();

            if (apodo !== '') {
                // Crear el elemento div para el nuevo participante
                const badge = document.createElement('div');
                badge.className = 'name-badge';
                badge.textContent = apodo;

                // Asignar un color aleatorio de la paleta
                const randomColor = colores[Math.floor(Math.random() * colores.length)];
                badge.style.backgroundColor = randomColor;

                // Añadirlo a la grilla de participantes
                document.getElementById('participantsGrid').appendChild(badge);

                // Limpiar el input y volver a enfocarlo
                input.value = '';
                input.focus();
            }
        });
    </script>
</body>
</html>
